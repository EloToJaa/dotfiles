{
  "favorites": [
    {
      "provider": "codex",
      "model": "gpt-6.1-sol"
    },
    {
      "provider": "codex",
      "model": "gpt-6-astra"
    },
    {
      "provider": "codex",
      "model": "gpt-6-luna"
    },
    {
      "provider": "claudeAgent",
      "model": "claude-opus-5-5"
    },
    {
      "provider": "claudeAgent",
      "model": "claude-sonnet-5-5"
    }
  ],
  "storageCleanup": {
    "worktreeAfterDays": 3,
    "worktreeOnMerge": true,
    "worktreeOnDelete": true,
    "browserArtifactsAfterDays": 5,
    "logsAfterDays": 5
  },
  "worktreesDirectory": "~/.worktrees",
  "enableProviderUpdateChecks": false,
  "speechPostProcessingModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-haiku-5-5"
  },
  "defaultAutoPull": true,
  "defaultModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-opus-5-5"
  },
  "defaultRuntimeMode": "auto",
  "projectSettingsFolded": true,
  "idleCompaction": "onReturn",
  "snoozeLimitedThreads": true,
  "autoResumeLimitedThreads": true,
  "sidebarAutoSettleKeepPullRequests": true,
  "backgroundActivity": {
    "schemaVersion": 1,
    "profile": "performance",
    "overrides": {}
  },
  "automaticGitFetchInterval": 15000,
  "providerHealthRefreshInterval": 60000,
  "backgroundActivityProfile": "performance",
  "defaultThreadEnvMode": "worktree",
  "addProjectBaseDirectory": "~/code",
  "branchNamingMode": "semantic",
  "removeAgentCreditsOnMerge": true,
  "sourceControlWritingStyle": {
    "mode": "conventional_commits"
  },
  "sourceControlWriterModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-sonnet-5-5",
    "options": [
      {
        "id": "effort",
        "value": "low"
      }
    ]
  },
  "reviewGuidesEnabled": true,
  "reviewGuideModelSelection": {
    "instanceId": "claudeAgent",
    "model": "claude-sonnet-5-5",
    "options": [
      {
        "id": "effort",
        "value": "low"
      }
    ]
  },
  "providerInstances": {
    "grok": {
      "driver": "grok",
      "enabled": true,
      "config": {
        "binaryPath": "grok",
        "customModels": []
      }
    },
    "cursor": {
      "driver": "cursor",
      "enabled": false,
      "config": {
        "binaryPath": "cursor-agent",
        "apiEndpoint": "",
        "customModels": []
      }
    },
    "opencode": {
      "driver": "opencode",
      "enabled": false,
      "config": {
        "binaryPath": "opencode",
        "serverUrl": "",
        "serverPassword": "",
        "customModels": []
      }
    },
    "claudeAgent": {
      "driver": "claudeAgent",
      "enabled": true,
      "config": {
        "binaryPath": "claude",
        "homePath": "",
        "customModels": [],
        "launchArgs": "",
        "autoCompactWindow": ""
      }
    },
    "antigravity": {
      "driver": "antigravity",
      "enabled": false,
      "config": {
        "authMethod": "oauth-personal",
        "apiKey": "",
        "gcpProject": "",
        "gcpLocation": "",
        "binaryPath": "",
        "customModels": []
      }
    },
    "codex": {
      "driver": "codex",
      "enabled": false
    }
  }
}
